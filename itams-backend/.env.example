# ==== SERVER ====
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000

# ==== JWT ====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ==== DATABASE (Neon Postgres) ====
# Get this from the Neon console -> your project -> Connection Details ->
# copy the full connection string (it already includes sslmode=require).
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ==== EMAIL (Gmail SMTP with App Password) ====
# 1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
# 2. Create an App Password: myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (no spaces)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=ITAMS Support

# ==== SEED / DEFAULT PASSWORD ====
# Used only by sql/seed.js to create the initial HR and Asset Manager logins.
# Change this after first login.
DEFAULT_SEED_PASSWORD=ITAMS@2026

# The frontend's Login page only accepts an EMP-style ID or a @gmail.com email —
# so these MUST be real Gmail inboxes you control, or you can't log in / get OTPs.
SEED_HR_EMAIL=your.hr.account@gmail.com
SEED_ASSET_MANAGER_EMAIL=your.assetmanager.account@gmail.com
