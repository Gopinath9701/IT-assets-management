# ==== SERVER ====
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ==== JWT ====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ==== DATABASE (Neon Postgres) ====
# Neon console -> your project -> Connection Details -> copy the full string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ==== EMAIL (Brevo — sends over HTTPS, not SMTP) ====
# brevo.com -> Settings -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=xkeysib-your_api_key
EMAIL_FROM_NAME=ITAMS Support
# Must be verified in Brevo first: Settings -> Senders, Domains & Dedicated
# IPs -> Senders -> Add a Sender -> click the confirmation link Brevo emails
# to that address. Once verified, this sender can email ANY recipient - no
# per-recipient whitelist needed (unlike Mailgun/Resend's sandbox modes).
BREVO_FROM_EMAIL=your_verified_sender@example.com

# ==== SEED ACCOUNTS ====
# HR/AssetManager/InventoryManager login emails are generated automatically
# as {loginId}@gmail.com (per the frontend's login/forgot-password spec).

# Must satisfy the password policy: 8-20 chars, at least one uppercase,
# one lowercase, one digit, one special character.
DEFAULT_SEED_PASSWORD=Itams@2026
