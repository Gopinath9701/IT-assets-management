# ==== SERVER ====
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ==== JWT ====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ==== DATABASE (Neon Postgres) ====
# Neon console -> your project -> Connection Details -> copy the full string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ==== EMAIL (Resend — sends over HTTPS, not SMTP) ====
# resend.com -> API Keys -> create one
RESEND_API_KEY=re_your_api_key
EMAIL_FROM_NAME=ITAMS Support
# Resend's shared sandbox address (default below) only delivers to the email
# your Resend account itself is registered with. To send OTP mail to real
# users, verify a domain in the Resend dashboard and set this to an address
# on it (e.g. otp@yourdomain.com).
RESEND_FROM_EMAIL=onboarding@resend.dev

# ==== SEED ACCOUNTS ====
# HR/AssetManager/InventoryManager login emails are generated automatically
# as {loginId}@gmail.com (per the frontend's login/forgot-password spec) —
# not real inboxes, so OTP mail to these accounts isn't deliverable yet.

# Must satisfy the password policy: 8-20 chars, at least one uppercase,
# one lowercase, one digit, one special character.
DEFAULT_SEED_PASSWORD=Itams@2026
