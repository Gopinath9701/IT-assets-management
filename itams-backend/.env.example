# ==== SERVER ====
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ==== JWT ====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ==== DATABASE (Neon Postgres) ====
# Neon console -> your project -> Connection Details -> copy the full string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ==== EMAIL (Gmail SMTP with App Password) ====
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=ITAMS Support
# Default 465 (SSL). If SMTP verification times out on your deployment host
# (many free-tier hosts block outbound port 465), try 587 (STARTTLS) — some
# hosts allow 587 but not 465. If both time out, the host is blocking
# outbound SMTP entirely and no port change will fix it; switch to an
# HTTP-based email API (SendGrid, Resend, Mailgun) instead.
EMAIL_SMTP_PORT=465

# ==== SEED ACCOUNTS ====
# HR/AssetManager/InventoryManager login emails are generated automatically
# as {loginId}@gmail.com (per the frontend's login/forgot-password spec) —
# not real inboxes, so OTP mail to these accounts isn't deliverable yet.

# Must satisfy the password policy: 8-20 chars, at least one uppercase,
# one lowercase, one digit, one special character.
DEFAULT_SEED_PASSWORD=Itams@2026
